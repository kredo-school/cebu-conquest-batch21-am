<IfModule mod_rewrite.c>
  RewriteEngine On

  # OPTIONS プリフライトを PHP に渡さず Apache レベルで即 200 を返す
  RewriteCond %{REQUEST_METHOD} OPTIONS
  RewriteRule ^(.*)$ - [R=200,L]
</IfModule>

<IfModule mod_headers.c>
  # 💡 解決策: OPTIONSリクエスト（挨拶）の時だけ、Apache 側で Origin ヘッダーを出す
  # これにより、本番の POST 通信時に PHP 側のヘッダーと重複するのを防ぎます
  SetEnvIf Request_Method OPTIONS IS_OPTIONS
  Header always set Access-Control-Allow-Origin "http://localhost:5173" env=IS_OPTIONS

  # メソッドとヘッダーの許可は常に必要なのでそのまま
  Header always set Access-Control-Allow-Methods "POST, GET, OPTIONS"
  Header always set Access-Control-Allow-Headers "Content-Type, Authorization"
</IfModule>